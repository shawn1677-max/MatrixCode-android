# Copy to keystore.properties and fill in. Never commit the real file.
# Generate an upload key with:
#   keytool -genkeypair -v -keystore codefall-upload.jks -alias codefall \
#     -keyalg RSA -keysize 4096 -validity 10000
storeFile=codefall-upload.jks
storePassword=CHANGE_ME
keyAlias=codefall
keyPassword=CHANGE_ME
