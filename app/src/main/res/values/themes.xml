<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Codefall" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorAccent">@color/code_green</item>
        <item name="android:colorPrimary">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:textColor">@color/code_green_pale</item>
    </style>

    <style name="Theme.Codefall.Fullscreen" parent="Theme.Codefall">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
